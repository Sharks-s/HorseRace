# =============================================================
# HorseRace — docker-compose environment  (matches deployment diagram)
# Copy to .env and fill in real values:  cp .env.example .env
#
# Topology (per diagram):  Browser --> fe:80 (static)
#                          Browser --> be:8080/api (REST, JWT)
#                          be --> db:5432  |  be --> smtp:587
# Replace HOST below with your server's domain or public IP.
# =============================================================

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=horserace
# Diagram exposes 5432:5432. SECURITY: in production use "127.0.0.1:5432" or
# firewall the port unless you truly need external DB access.
DB_PORT=5432

# --- Backend (exposed on host per diagram) ---
BE_PORT=8080
# Seed data.sql on startup. Set to "never" once the DB is already seeded.
SQL_INIT_MODE=always
# Public URL of the frontend (used in emails / verification links).
# In production: http://HOST  (or your real domain)
APP_FRONTEND_URL=http://localhost
# Browser origins allowed to call the API (CORS). Must include the FE origin.
# In production: http://HOST
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
HORSE_MAX_WEIGHT=650

# --- SMTP (leave blank to disable outbound mail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Frontend (public entrypoint, port 80 per diagram) ---
FE_PORT=80
# Baked into the JS bundle at build time. Browser calls the backend DIRECTLY.
# In production set this to your server:  http://HOST:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
